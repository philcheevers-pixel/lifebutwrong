# Truth Serum environment
# Copy to .env on the droplet (do not commit secrets)

ANTHROPIC_API_KEY=
BRAVE_API_KEY=
TRUTHSERUM_MODEL=claude-sonnet-4-20250514
TRUTHSERUM_MAX_WORDS=3000
TRUTHSERUM_MAX_CLAIMS=40
TRUTHSERUM_RATE_LIMIT_PER_DAY=5
TRUTHSERUM_MAX_UPLOAD_BYTES=2097152
TRUTHSERUM_CORS=*
# TRUTHSERUM_KOFI_URL is set in the web UI / extension; optional mirror:
# TRUTHSERUM_KOFI_URL=https://ko-fi.com/yourpage
